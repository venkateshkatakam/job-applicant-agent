{
  "name": "job-applicant-agent",
  "version": "1.0.4",
  "private": true,
  "description": "Local-first job matching and Gmail draft assistant",
  "author": "Job Applicant Agent",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "concurrently -k \"npm:dev\" \"npm:watch:desktop\" \"wait-on tcp:127.0.0.1:5173 dist-electron/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "watch:desktop": "tsc -p tsconfig.electron.json --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:desktop": "npm run build && node tests/desktop.smoke.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "html-to-text": "^10.0.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@playwright/test": "^1.64.1",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.jobapplicant.agent",
    "productName": "Job Applicant Agent",
    "asar": true,
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "google-oauth.json",
          "icon.png"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "resources/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
